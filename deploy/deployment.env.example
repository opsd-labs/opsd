# GHCR 部署环境示例（不含凭据）
OPSD_IMAGE=ghcr.io/opsd-labs/opsd:latest
OPSD_CONSOLE_PORT=65535
OPSD_AGENT_PORT=8444
OPSD_ENROLLMENT_PORT=8443
OPSD_ENROLLMENT_BIND=0.0.0.0:8443
OPSD_CONSOLE_BIND=0.0.0.0
OPSD_AGENT_BIND=0.0.0.0
OPSD_ORIGIN=https://<C091-管理地址>:65535
OPSD_AGENT_ORIGIN=https://<C091-公网地址>:65535
OPSD_ENROLLMENT_ORIGIN=https://<C091-公网地址>:8443
