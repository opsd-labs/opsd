      {"name": "collected_at", "type": "integer", "optional": true, "nullable": true, "description": "盘点时间（unix 秒），未采集为 null"},
      {"name": "gaps", "type": "array<string>", "optional": false, "nullable": false, "description": "采集缺口"},
      {"name": "link_mbps", "type": "integer", "optional": true, "nullable": true, "description": "最快链路速率 Mbps"}
    ]},
    {"name": "Rejected", "fields": [
      {"name": "device", "type": "string", "optional": false, "nullable": false, "description": "设备名"},
      {"name": "reason", "type": "string", "optional": false, "nullable": false, "description": "拒绝原因"}
    ]},
    {"name": "Check", "fields": [
      {"name": "name", "type": "string", "optional": false, "nullable": false, "description": "检查项名"},
      {"name": "passed", "type": "boolean", "optional": false, "nullable": false, "description": "是否通过"},
      {"name": "detail", "type": "string", "optional": false, "nullable": false, "description": "不通过时的说明"}
    ]},
    {"name": "Topology", "fields": [
      {"name": "nodes", "type": "integer", "optional": false, "nullable": false, "description": "节点数"},
      {"name": "drives_per_node", "type": "integer", "optional": false, "nullable": false, "description": "每节点盘数"},
      {"name": "drive_size", "type": "integer", "optional": false, "nullable": false, "description": "最小盘容量字节"},
      {"name": "raw_capacity", "type": "integer", "optional": false, "nullable": false, "description": "原始裸容量"},
      {"name": "parity", "type": "integer", "optional": false, "nullable": false, "description": "纠删码校验盘数"},
      {"name": "usable_capacity", "type": "integer", "optional": false, "nullable": false, "description": "扣除校验可用容量"},
      {"name": "parity_note", "type": "string", "optional": false, "nullable": false, "description": "校验说明"}
    ]},
    {"name": "Report", "fields": [
      {"name": "generated_at", "type": "integer", "optional": false, "nullable": false, "description": "生成时间"},
      {"name": "nodes", "type": "array<NodeVerdict>", "optional": false, "nullable": false, "description": "逐节点结论"},
      {"name": "checks", "type": "array<Check>", "optional": false, "nullable": false, "description": "一致性检查"},
      {"name": "topology", "type": "Topology", "optional": true, "nullable": true, "description": "推荐拓扑"},
      {"name": "ready", "type": "boolean", "optional": false, "nullable": false, "description": "是否可直接部署"},
      {"name": "summary", "type": "string", "optional": false, "nullable": false, "description": "总结"}
    ]},
    {"name": "ClusterSpec", "fields": [
      {"name": "name", "type": "string", "optional": false, "nullable": false, "description": "集群名称"},
      {"name": "nodes", "type": "array<string>", "optional": false, "nullable": false, "description": "节点编号"},
      {"name": "image_tag", "type": "string", "optional": false, "nullable": false, "description": "固定 release 标签"},
      {"name": "endpoint", "type": "string", "optional": false, "nullable": false, "description": "对外服务地址"},
      {"name": "access_key", "type": "string", "optional": false, "nullable": false, "description": "访问键名"},
      {"name": "secret_key", "type": "string", "optional": false, "nullable": false, "description": "访问密钥"},
      {"name": "created_at", "type": "integer", "optional": true, "nullable": false, "description": "创建时间（serde default）"}
    ]},
    {"name": "StorageDeviceTarget", "fields": [
      {"name": "path", "type": "string", "optional": false, "nullable": false, "description": "设备路径"},
      {"name": "expected_size", "type": "integer", "optional": false, "nullable": false, "description": "计划时记录的容量字节"},
      {"name": "mount", "type": "string", "optional": false, "nullable": false, "description": "挂载点，如 /data/disk1"}
    ]},
    {"name": "PlannedNode", "fields": [
      {"name": "node_id", "type": "string", "optional": false, "nullable": false, "description": "节点编号"},
      {"name": "name", "type": "string", "optional": false, "nullable": false, "description": "节点名"},
      {"name": "devices", "type": "array<StorageDeviceTarget>", "optional": false, "nullable": false, "description": "将被清空的设备及计划容量"},
      {"name": "mounts", "type": "array<string>", "optional": false, "nullable": false, "description": "执行完成后对外挂载点"}
    ]},
    {"name": "Plan", "fields": [
      {"name": "id", "type": "string", "optional": false, "nullable": false, "description": "计划 id"},
      {"name": "cluster", "type": "string", "optional": false, "nullable": false, "description": "集群名"},
      {"name": "created_at", "type": "integer", "optional": false, "nullable": false, "description": "创建时间"},
      {"name": "expires", "type": "integer", "optional": false, "nullable": false, "description": "有效期（unix 秒）= now()+300"},
      {"name": "fingerprint", "type": "string", "optional": false, "nullable": false, "description": "预检指纹，候选集合变化即失效"},
      {"name": "nodes", "type": "array<PlannedNode>", "optional": false, "nullable": false, "description": "计划内各节点步骤"},
      {"name": "image", "type": "string", "optional": false, "nullable": false, "description": "镜像引用 pgsty/silo:<image_tag>"},
      {"name": "destructive", "type": "boolean", "optional": false, "nullable": false, "description": "是否含不可逆步骤（本模块固定为 true）"},
      {"name": "irreversible_notice", "type": "string", "optional": false, "nullable": false, "description": "不可逆步骤告知，界面须原文展示"},
      {"name": "completed", "type": "array<string>", "optional": true, "nullable": false, "description": "已执行完成节点 id（serde default 空数组）"},
      {"name": "failed", "type": "array<tuple2>", "optional": true, "nullable": false, "description": "失败节点与原因，序列化为 [node_id, reason] 二元数组；serde default 空数组"}
    ]}
  ],
  "notes": "1) 破坏性确认字段名为 acknowledge_destructive（serde default=false），在 apply 的请求体里逐字如此。2) 计划有效期字段为 expires（unix 秒），指纹字段为 fingerprint；read_plan 额外返回 expired 布尔（expires<=now()）。3) 执行接口返回 200 而非 202，且不是单个 task_id——apply 返回 {plan_id, dispatched[], completed[]}；宿主机制产生多个任务（每节点两步骤，每步一个 task）。4) 单值任务（host_inspect、bucket、user、status）才返回 200 + {task_id, node, label}。5) 失败块断在 apply 里通过 plan.failed 累积并在响应 400 的 error 正文里说明\"已失败，已阻断其后节点\"。6) 幂等：host_inspect 用 idempotency_key；bucket/user/status 用随机内部 id 作任务键（id()），apply 各步骤用 {plan_id}-{label} 作键。疑：步骤键能否幂等去重未在函数内显式保证（依赖 accept_task 按 (node_id,key) 判重），已按源码原样记录。7) 未确认计划生成时是否对 ClusterSpec 下 secret_key 做处理：plan 接口 load_spec 原样取 spec，未抹 key；只有 clusters 列表会抹。8) 所有 2xx 之外的错误走 ApiError，统一正文 {\"error\":消息}；但 auth::require 在 CSRF/Origin 失败时返回 403 且正文为纯文本（非 JSON），未登录为 JSON {\"error\":\"请先登录\"}。9) 本模块与 mTLS 面（/agent 等）无关，未列。"
}