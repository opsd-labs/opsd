                  "machine_id": {
                    "type": "string"
                  },
                  "instance_id": {
                    "type": "string"
                  },
                  "disabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "idempotency_key",
                  "machine_id",
                  "instance_id",
                  "disabled"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "仅受理，实际结果通过核心任务接口读取",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "task_id",
                    "status"
                  ],
                  "additionalProperties": false
