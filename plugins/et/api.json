        "responses": {
          "200": {
            "description": "实际请求结果",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/info": {
      "post": {
        "summary": "读取或操作插件会话/info",
        "requestBody": {
