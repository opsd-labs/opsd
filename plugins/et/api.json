                },
                "required": [
                  "machine_id",
                  "instance_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "实际请求结果",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/config": {
      "post": {
        "summary": "读取或操作插件会话/config",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "machine_id": {
                    "type": "string"
