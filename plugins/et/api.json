    "/config/update": {
      "post": {
        "summary": "提交持久任务/config/update",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotency_key": {
                    "type": "string"
                  },
                  "machine_id": {
                    "type": "string"
                  },
                  "instance_id": {
                    "type": "string"
                  },
                  "patch": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "idempotency_key",
                  "machine_id",
                  "instance_id",
                  "patch"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "仅受理，实际结果通过核心任务接口读取",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "task_id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
