    "/web/install": {
      "post": {
        "summary": "部署固定版本 ET Web，或核实后继续原部署",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "idempotency_key": {
                        "type": "string"
                      },
                      "node_id": {
                        "type": "string"
                      },
                      "bind_address": {
                        "type": "string"
                      },
                      "api_port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "config_port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "protocol": {
                        "enum": [
                          "tcp",
                          "udp"
                        ]
                      },
                      "data_dir": {
                        "type": "string"
                      },
                      "api_url": {
                        "type": "string",
                        "format": "uri"
                      }
                    },
                    "required": [
                      "idempotency_key",
                      "node_id",
                      "bind_address",
                      "api_port",
                      "config_port",
                      "protocol",
                      "data_dir",
                      "api_url"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "idempotency_key": {
                        "type": "string"
                      },
                      "resume": {
                        "const": true
                      }
                    },
                    "required": [
                      "idempotency_key",
                      "resume"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "仅受理，实际结果通过核心任务接口读取",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "task_id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
