                          "type": "string"
                        }
                      },
                      "config_endpoint": {
                        "type": "string"
                      },
                      "peer_urls": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "listener_urls": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "idempotency_key",
                      "name",
                      "cidr",
                      "nodes",
                      "config_endpoint",
                      "peer_urls",
                      "listener_urls"
                    ],
                    "additionalProperties": false
