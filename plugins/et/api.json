{
  "openapi": "3.1.0",
  "info": {
    "title": "EasyTier 网络 业务接口",
    "version": "0.1.0",
    "description": "挂在 /{安全入口}/api/v1/plugins/et/api 下。Cookie、Origin 与 CSRF 由核心校验；秘密通过受保护存储引用。"
  },
  "paths": {
    "/machines": {
      "get": {
        "summary": "读取或操作插件会话/machines",
        "responses": {
          "200": {
            "description": "实际请求结果",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/instances": {
      "post": {
        "summary": "读取或操作插件会话/instances",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "machine_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "machine_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "实际请求结果",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
