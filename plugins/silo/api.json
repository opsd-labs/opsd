{
  "openapi": "3.1.0",
  "info": {
    "title": "Silo 分布式存储 业务接口",
    "version": "0.2.0",
    "description": "挂在 /{安全入口}/api/v1/plugins/silo/api 下。Cookie、Origin 与 CSRF 由核心校验；秘密通过受保护存储引用。"
  },
  "paths": {
    "/setup": {
      "get": {
        "summary": "读取业务就绪状态与已保存的初始化进度",
        "responses": {
          "200": {
            "description": "实际状态；读取不会创建节点检测任务",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "needs_configuration",
                        "needs_network",
                        "needs_docker",
                        "needs_installation",
                        "unavailable",
                        "ready"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/clusters": {
      "get": {
        "summary": "读取或操作插件会话/clusters",
        "responses": {
          "200": {
            "description": "实际请求结果",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/inventory": {
      "post": {
        "summary": "提交持久任务/inventory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotency_key": {
                    "type": "string"
                  },
                  "node_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "idempotency_key",
                  "node_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "仅受理，实际结果通过核心任务接口读取",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "task_id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/install": {
      "post": {
        "summary": "提交持久任务/install",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idempotency_key",
                  "name"
                ],
                "properties": {
                  "idempotency_key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "resume": {
                    "type": "boolean"
                  },
                  "acknowledge_destructive": {
                    "type": "boolean"
                  },
                  "image": {
                    "type": "string"
                  },
                  "members": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "node_id": {
                          "type": "string"
                        },
                        "storage": {
                          "type": "array",
                          "items": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "mode": {
                                    "const": "new"
                                  },
                                  "device": {
                                    "type": "string"
                                  },
                                  "expected_size": {
                                    "type": "integer"
                                  },
                                  "serial": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "mount": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "mode",
                                  "device",
                                  "expected_size",
                                  "mount"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "mode": {
                                    "const": "existing"
                                  },
                                  "path": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "mode",
                                  "path"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          }
                        }
                      },
                      "required": [
                        "node_id",
                        "storage"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "仅受理，实际结果通过核心任务接口读取",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "task_id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/bucket": {
      "post": {
        "summary": "提交持久任务/bucket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotency_key": {
                    "type": "string"
                  },
                  "cluster": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "list",
                      "create",
                      "remove"
                    ]
                  },
                  "bucket": {
                    "type": "string"
                  }
                },
                "required": [
                  "idempotency_key",
                  "cluster",
                  "operation"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "仅受理，实际结果通过核心任务接口读取",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "task_id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/user": {
      "post": {
        "summary": "提交持久任务/user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotency_key": {
                    "type": "string"
                  },
                  "cluster": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "list",
                      "create",
                      "remove"
                    ]
                  },
                  "user": {
                    "type": "string"
                  },
                  "secret_name": {
                    "type": "string"
                  },
                  "policy": {
                    "type": "string",
                    "enum": [
                      "readonly",
                      "readwrite",
                      "writeonly",
                      "diagnostics"
                    ]
                  }
                },
                "required": [
                  "idempotency_key",
                  "cluster",
                  "operation"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "仅受理，实际结果通过核心任务接口读取",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "task_id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/status": {
      "post": {
        "summary": "提交持久任务/status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotency_key": {
                    "type": "string"
                  },
                  "cluster": {
                    "type": "string"
                  }
                },
                "required": [
                  "idempotency_key",
                  "cluster"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "仅受理，实际结果通过核心任务接口读取",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "task_id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "参数无效或明确失败"
          },
          "409": {
            "description": "执行结果不确定，须核实后恢复"
          }
        }
      }
    },
    "/readiness": {
      "get": {
        "summary": "读取插件的存储适合度与推荐拓扑",
        "responses": {
          "200": {
            "description": "只使用明确取得的主机盘点；缺失时标为待采集。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Suitability": {
        "type": "string",
        "description": "结论等级：可直接进入部署计划 / 有条件可用 / 硬性阻断 / 尚未采集（不算不适合）。",
        "enum": [
          "suitable",
          "needs_work",
          "unsuitable",
          "pending"
        ]
      },
      "Candidate": {
        "type": "object",
        "required": [
          "device",
          "path",
          "size",
          "rotational"
        ],
        "properties": {
          "device": {
            "type": "string",
            "description": "设备名。"
          },
          "path": {
            "type": "string",
            "description": "设备路径。"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "容量字节。"
          },
          "rotational": {
            "type": "boolean",
            "description": "是否机械盘。"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "磁盘型号，可缺失或为 null。"
          }
        },
        "additionalProperties": false
      },
      "Rejected": {
        "type": "object",
        "required": [
          "device",
          "reason"
        ],
        "properties": {
          "device": {
            "type": "string",
            "description": "设备名。"
          },
          "reason": {
            "type": "string",
            "description": "拒绝原因。"
          }
        },
        "additionalProperties": false
      },
      "StorageNodeVerdict": {
        "type": "object",
        "required": [
          "node_id",
          "name",
          "online",
          "suitability",
          "reasons",
          "candidates",
          "rejected",
          "gaps"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "description": "节点编号。"
          },
          "name": {
            "type": "string",
            "description": "节点名。"
          },
          "online": {
            "type": "boolean",
            "description": "是否在线。"
          },
          "suitability": {
            "$ref": "#/components/schemas/Suitability"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "逐条结论原因，界面直接展示。"
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "description": "候选盘。"
          },
          "rejected": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Rejected"
            },
            "description": "被拒盘及原因，便于运维核对。"
          },
          "collected_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "盘点时间（unix 秒），未采集为 null。"
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "采集缺口。"
          },
          "link_mbps": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "该节点最快物理链路速率（Mbps），未采集为 null。"
          }
        },
        "additionalProperties": false
      },
      "Check": {
        "type": "object",
        "required": [
          "name",
          "passed",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "检查项名。"
          },
          "passed": {
            "type": "boolean",
            "description": "是否通过。"
          },
          "detail": {
            "type": "string",
            "description": "不通过时的具体说明。"
          }
        },
        "additionalProperties": false
      },
      "Topology": {
        "type": "object",
        "required": [
          "nodes",
          "drives_per_node",
          "drive_size",
          "raw_capacity",
          "parity",
          "usable_capacity",
          "parity_note"
        ],
        "properties": {
          "nodes": {
            "type": "integer",
            "description": "节点数。"
          },
          "drives_per_node": {
            "type": "integer",
            "description": "每节点盘数。"
          },
          "drive_size": {
            "type": "integer",
            "format": "int64",
            "description": "最小盘容量字节，容量按最小盘计算。"
          },
          "raw_capacity": {
            "type": "integer",
            "format": "int64",
            "description": "原始裸容量。"
          },
          "parity": {
            "type": "integer",
            "description": "纠删码校验盘数。"
          },
          "usable_capacity": {
            "type": "integer",
            "format": "int64",
            "description": "扣除校验后的可用容量。"
          },
          "parity_note": {
            "type": "string",
            "description": "校验说明，例如「共 N 块盘，校验 P 块；容量按最小盘 X 计算」。"
          }
        },
        "additionalProperties": false
      },
      "Report": {
        "type": "object",
        "required": [
          "generated_at",
          "nodes",
          "checks",
          "ready",
          "summary"
        ],
        "properties": {
          "generated_at": {
            "type": "integer",
            "format": "int64",
            "description": "报告生成时间（unix 秒）。"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StorageNodeVerdict"
            },
            "description": "逐节点结论。"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "description": "一致性检查项。"
          },
          "topology": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Topology"
              },
              {
                "type": "null"
              }
            ],
            "description": "推荐拓扑；条件不满足时为 null。"
          },
          "ready": {
            "type": "boolean",
            "description": "总体是否可直接进入部署计划。"
          },
          "summary": {
            "type": "string",
            "description": "面向运维的总结说明。"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
